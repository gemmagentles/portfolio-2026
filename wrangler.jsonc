// Cloudflare hosting settings, read by `npx wrangler deploy` (Cloudflare runs it after `npm run build`).
// It uploads the built `dist/` folder as static assets, plus one small Worker (worker/index.js) that handles the
// contact form. Only /api/* reaches the Worker; every other request is served straight from the assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "portfolio-2026",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Unknown addresses get the site's own 404 page (dist/404.html) with a 404 status.
    "not_found_handling": "404-page"
  },
  // Sending email from the Worker, free through Email Routing: on the free plan it can only send to addresses verified
  // under Email Routing → Destination addresses (Gemma's own inbox), so the form can't be used to email anyone else.
  // Which verified address is a private setting (the CONTACT_TO secret), so it isn't in this public repo.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    // The sender shown on the email: any address on gemmagentles.dev (Email Routing must be on for the domain).
    "CONTACT_FROM": "hi@gemmagentles.dev",
    // Where a Turnstile token may come from (the live site only; local testing sets its own in .dev.vars).
    "TURNSTILE_HOSTNAMES": "gemmagentles.dev,www.gemmagentles.dev"
  }
  // Secrets, set with `npx wrangler secret put <NAME>` (or the dashboard), never here:
  // - TURNSTILE_SECRET: the Turnstile widget's secret key
  // - CONTACT_TO: the verified Email Routing destination address the messages go to
}
